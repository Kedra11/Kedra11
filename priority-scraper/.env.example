# Скопируй этот файл в .env и впиши свои реальные значения.
# .env лежит в .gitignore и никуда не коммитится — пароль остаётся только у тебя.

# Адрес твоего Priority (внутренний). Пример:
# PRIORITY_URL=https://fbc-priority.xxxx.internal/
PRIORITY_URL=https://your-priority-host.internal/

# Логин/пароль. Можно оставить пустыми — тогда при setup залогинишься руками в открытом браузере.
PRIORITY_USER=
PRIORITY_PASS=

# headless=1 — браузер невидимый; headless=0 — видно окно (удобно для первой настройки).
HEADLESS=0
