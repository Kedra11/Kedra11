# Скопируй этот файл в .env и впиши свои значения.
# .env лежит в .gitignore и никуда не коммитится.

# Адрес твоего Priority (внутренний). Пример:
# PRIORITY_URL=https://fbc-priority.xxxx.internal/
PRIORITY_URL=https://your-priority-host.internal/

# Браузер: "msedge" — рулить твоим установленным Edge (рекомендуется для
# внутренней сети: доверяет корп-сертификату). Пусто — свой Chromium.
PW_CHANNEL=msedge

# Логин/пароль НЕ обязательны и НЕ рекомендуются: лучше залогиниться руками
# один раз через `python scrape.py setup` — тогда сохранится только сессия,
# а пароль нигде не хранится. Оставь пустыми.
PRIORITY_USER=
PRIORITY_PASS=

# headless=1 — браузер невидимый; headless=0 — видно окно.
HEADLESS=0
